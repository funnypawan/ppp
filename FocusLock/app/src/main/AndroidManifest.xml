<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Read per-app usage statistics. This is a special access permission:
         the user grants it manually in Android Settings > Usage access. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Core functionality: the user must be able to see and set a limit for
         EVERY installed app, so package visibility must not be filtered. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Lets the blocking screen appear reliably over other apps.
         Optional, but strongly recommended; requested with explanation. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Foreground monitoring service + boot restore -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Emergency countdown + protection warnings (Android 13+ runtime permission) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Lets us *ask* the user to exclude FocusLock from battery optimization -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- On devices where QUERY_ALL_PACKAGES is unavailable, still resolve
         launchers and dialers (never blocked, so calls/home always work). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
    </queries>

    <application
        android:name=".FocusLockApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FocusLock"
        tools:targetApi="34">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.PermissionSetupActivity"
            android:exported="false"
            android:label="@string/setup_title" />

        <!-- Full-screen blocking screen shown when an app reaches its limit.
             Lives in its own task so it never mixes with the blocked app. -->
        <activity
            android:name=".ui.BlockingActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="@string/blocking_title"
            android:launchMode="singleTop"
            android:taskAffinity="" />

        <!-- Detects which app comes to the foreground so limits can be enforced.
             Configured with canRetrieveWindowContent=false: FocusLock receives
             only window-change events (package names), never screen content. -->
        <service
            android:name=".service.FocusLockAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Polls usage statistics as a second enforcement layer (catches apps
             that reach their limit mid-session and devices without the
             accessibility service enabled). -->
        <service
            android:name=".service.MonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Monitors foreground app usage to enforce the daily per-app time limits the user configured in FocusLock." />
        </service>

        <!-- Restores protection after reboot / app update -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
