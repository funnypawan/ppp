<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ data extraction rules: only FocusLock's own local data. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="focuslock.db" />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="focuslock.db" />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
