    <!-- Accessibility disclosure (shown by Android in accessibility settings) -->
    <string name="accessibility_service_name">FocusLock App Limiter</string>
    <string name="accessibility_service_description">FocusLock uses this accessibility service for one purpose only: to know which app is currently in the foreground, so the daily time limits YOU set can be enforced and a blocking screen can be shown when a limit is reached.\n\nThe service is configured so it cannot read screen content, text, passwords or notifications. No accessibility data is stored remotely or shared with anyone. You can turn it off at any time here in Android Settings.</string>

