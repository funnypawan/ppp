    <!-- Permission setup -->
    <string name="setup_title">Set up FocusLock</string>
    <string name="setup_intro">FocusLock needs a few permissions to measure app usage and enforce the daily limits you set. Your limits and usage data always stay on this phone — no account, no server. The app is free with ads (Google AdMob).</string>
    <string name="perm_usage_title">Usage Access</string>
    <string name="perm_usage_desc">Required. Lets FocusLock see how long each app has been used today (Android UsageStats). Without it, usage cannot be measured and limits cannot be enforced.</string>
    <string name="perm_accessibility_title">Accessibility Service</string>
    <string name="perm_accessibility_desc">Required for instant blocking. It only tells FocusLock which app is in the foreground so an over-limit app can be blocked immediately. FocusLock is configured so it can NEVER read screen content, text or passwords.</string>
    <string name="perm_overlay_title">Display over other apps</string>
    <string name="perm_overlay_desc">Recommended. Allows the blocking screen to appear reliably over the blocked app on all Android versions.</string>
    <string name="perm_notifications_title">Notifications</string>
    <string name="perm_notifications_desc">Recommended. Shows the protection status and the live emergency-session countdown.</string>
    <string name="perm_battery_title">Ignore battery optimization</string>
    <string name="perm_battery_desc">Recommended. Stops Android from putting FocusLock to sleep, so limits keep working all day.</string>
    <string name="perm_autostart_title">Autostart (some phones)</string>
    <string name="perm_autostart_desc">On Xiaomi, Oppo, Vivo and similar phones, also allow “Autostart” for FocusLock so protection restarts after a reboot.</string>
    <string name="perm_status_granted">Granted</string>
    <string name="perm_status_missing">Not granted</string>
    <string name="perm_open_settings">Open settings</string>
    <string name="perm_required_badge">Required</string>
    <string name="perm_recommended_badge">Recommended</string>
    <string name="setup_continue">Continue</string>
    <string name="setup_skip_note">You can continue now, but protection will stay limited until the required permissions are granted. You can change them anytime in Settings.</string>

