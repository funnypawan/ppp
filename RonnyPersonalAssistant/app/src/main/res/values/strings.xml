    <!-- Reliability -->
    <string name="rel_title">Make reminders reliable</string>
    <string name="rel_intro">Android limits background work to save battery. Ronny Personal Assistant works fully offline, but the phone must allow a few things for alarms to ring on time.</string>
    <string name="rel_notifications">Notifications</string>
    <string name="rel_notifications_desc">Required to show the reminder card and its Done / Snooze buttons.</string>
    <string name="rel_exact">Exact alarms</string>
    <string name="rel_exact_desc">Lets the app fire at 04:30, 05:00, 09:00 exactly instead of "around then".</string>
    <string name="rel_battery">Battery optimization</string>
    <string name="rel_battery_desc">Turn this off for the app so Android does not delay alarms while the phone sleeps.</string>
    <string name="rel_autostart">Auto-start / background activity</string>
    <string name="rel_autostart_desc">On Xiaomi, Redmi, Oppo, Vivo, Realme, Samsung and Huawei phones, allow Auto-start and disable any battery saver for this app so reminders survive a reboot.</string>
    <string name="rel_tts">Hindi speech data</string>
    <string name="rel_tts_desc">Install Hindi (India) speech data in Android Text-to-Speech settings for natural Hindi voice reminders.</string>
    <string name="rel_state_ok">Allowed</string>
    <string name="rel_state_todo">Needs attention</string>
    <string name="rel_state_unknown">Not required on this device</string>
    <string name="rel_fix">Fix</string>
    <string name="rel_open">Open</string>

