<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. For local development against http://10.0.2.2:3000 add a
     domain-config for 10.0.2.2 with cleartextTrafficPermitted="true" (debug only). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
