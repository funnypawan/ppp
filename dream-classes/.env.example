# Dream Classes — environment configuration
# Copy these names into Render/your host. Never commit real secret values.
# Generate a JWT secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

PORT=3000
NODE_ENV=production

# --- Security ---
JWT_SECRET=replace_with_64_char_random_hex
TRUST_PROXY=1
# Extra browser origins (comma separated). Capacitor origins are built in.
ALLOWED_ORIGINS=

# --- Persistent database + uploads ---
# On Render, attach a paid Persistent Disk and mount it at /var/data, then set:
STORAGE_DIR=/var/data/dream-classes
# Or set DATA_DIR and UPLOADS_DIR separately. If all are blank, the app uses
# dream-classes/data and dream-classes/uploads (ephemeral on Render free).
DATA_DIR=
UPLOADS_DIR=
# Keep 1/blank normally. Set 0 only for isolated tests where an old local DB
# must not be copied into a fresh DATA_DIR.
MIGRATE_LEGACY_DB=1

# --- First Super Admin (used by: node seed.js) ---
# There is deliberately NO default password. Use at least 12 characters.
ADMIN_EMAIL=admin@dreamclasses.in
ADMIN_PASSWORD=replace_with_strong_password_min_12_chars
# Only needed if no Super Admin exists and you want to use the protected
# first-time setup form in /admin. Use 24+ random characters.
ADMIN_SETUP_TOKEN=
# Emergency repair only: set ADMIN_PASSWORD_RESET=1 together with a new strong
# ADMIN_PASSWORD, redeploy once, login, then REMOVE ADMIN_PASSWORD_RESET.
ADMIN_PASSWORD_RESET=

# --- OTP / SMS (backend only) ---
OTP_MODE=production
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_MOBILE_HOUR=5
OTP_MAX_PER_IP_HOUR=30

# Choose ONE provider. Leave SMS_PROVIDER blank to auto-detect from keys.
# SMS_PROVIDER=msg91
# MSG91 option: auth key + approved OTP/DLT template ID from MSG91.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# 2Factor option: API key; template name is optional.
# SMS_PROVIDER=2factor
TWOFACTOR_API_KEY=
TWOFACTOR_TEMPLATE_NAME=

# Local automated tests only. Production ignores ALLOW_DEV_OTP automatically.
# ALLOW_DEV_OTP=1

# --- Web Push (VAPID keys are auto-generated into the database) ---
VAPID_EMAIL=admin@dreamclasses.in
