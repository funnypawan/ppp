# Dream Classes — environment configuration (COPY to .env, never commit real values)
# Generate secrets:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

PORT=3000
NODE_ENV=production

# --- Security ---
JWT_SECRET=replace_with_64_char_random_hex
TRUST_PROXY=1
# Extra browser origins allowed to call the API (comma separated). Capacitor defaults are built in.
ALLOWED_ORIGINS=https://localhost,capacitor://localhost,http://localhost

# --- First Super Admin (used once by: node seed.js) ---
ADMIN_EMAIL=admin@dreamclasses.in
ADMIN_PASSWORD=replace_with_strong_password_min_12_chars

# --- OTP (student login) ---
# DEV MODE (default): OTP is shown on the login screen — testing only, server logs a warning.
# PRODUCTION: set OTP_MODE=production AND provide MSG91 credentials below,
# otherwise OTP requests return a clear "not configured" error (never a fake success).
OTP_MODE=production
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_TEMPLATE_ID=your_approved_dlt_template_id_here

# --- Web Push (works out of the box; VAPID keys are auto-generated into the DB) ---
VAPID_EMAIL=admin@dreamclasses.in

# --- Optional: native Android push via Firebase (only for a future native build) ---
# FIREBASE_SERVICE_ACCOUNT=/absolute/path/to/service-account.json
